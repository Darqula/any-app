# Copy to .env and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anyapp

# Any OpenAI-compatible chat-completions endpoint works here (OpenAI itself, a
# local server, a gateway, etc). Leave OPENAI_BASE_URL empty to use OpenAI's
# own endpoint.
#
# Note: the generator sends `max_tokens`, the field most OpenAI-compatible
# servers use (vLLM, llama.cpp, OpenRouter, most gateways). OpenAI's own newer
# reasoning models reject that and require `max_completion_tokens` instead —
# pointing OPENAI_BASE_URL at OpenAI with one of those models returns a 400.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Optional. The planner call is small and blocks first paint, so a faster model here is
# usually worth it. Falls back to OPENAI_MODEL when empty.
OPENAI_PLANNER_MODEL=

# Set to true only for a "reasoning" model — one that spends part of max_tokens on a
# hidden reasoning/thinking pass before writing the actual output (e.g. LongCat, Kimi
# K2.7 Code). Confirmed necessary for glm-5.3-flash: at the default budgets it burned the
# whole call on reasoning and returned empty content. When true, the generator triples
# (roughly) the max_tokens it sends on every call, at the cost of latency and spend.
OPENAI_REASONING_MODEL=

INTERNAL_SECRET=dev-only-change-me
STUDIO_PORT=3000
SANDBOX_PORT=3001
STUDIO_INTERNAL_URL=http://localhost:3000
SANDBOX_PUBLIC_URL=http://127.0.0.1:3001

# Copy to .env and fill in.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/anyapp

# --- Data API for generated apps (Phase 5) --------------------------------------
# The sandbox's own connection. A role with rights to `records` and nothing else — it must
# never be able to read generations or provider_credentials. See .docs/architecture.md's
# "Dependency rules", and packages/store/migrations/005_records.sql for the SQL that creates this role. Falls back to
# DATABASE_URL only so a fresh checkout boots; that fallback is a development convenience
# and is wrong in any shared environment.
SANDBOX_DATABASE_URL=postgres://anyapp_sandbox:choose-one@localhost:5432/anyapp

# --- Model configuration (Phase 3.5) --------------------------------------------
# Defaults for every call. Roles below override individually; leave a role's vars
# empty to inherit these.
LLM_PROVIDER=openai              # openai | anthropic
LLM_MODEL=gpt-4o
LLM_MAX_TOKENS=

# The planner is small and blocks first paint — a fast model pays off here.
LLM_PLANNER_PROVIDER=
LLM_PLANNER_MODEL=
LLM_PLANNER_MAX_TOKENS=20000

# Fill writes app content and is the call most likely to need a capable model.
# LLM_FILL_MAX_TOKENS is the SEQUENTIAL (whole-document) budget — one call writes every
# region. LLM_FILL_SLOT_MAX_TOKENS (Phase 4) is separate on purpose: it's the PARALLEL
# per-region budget, used only when LLM_FILL_MODE=parallel. Overloading one variable with
# two meanings tied to a mode toggle made an early sequential-vs-parallel comparison
# uncontrolled (see .docs/open-problems.md's Phase 4 section) — two variables means
# flipping the mode can't silently hand one arm the wrong budget.
LLM_FILL_PROVIDER=
LLM_FILL_MODEL=
LLM_FILL_MAX_TOKENS=32000
LLM_FILL_SLOT_MAX_TOKENS=8000

# Slot calls run concurrently up to this many at a time — a provider will rate-limit a
# burst long before an app has enough slots for more concurrency to be free.
LLM_FILL_CONCURRENCY=4

# parallel | sequential. Sequential is Phase 3.5's single call writing every region, kept
# so the two can be compared: one call can make every region agree by construction; N
# calls cannot and have to be told to stay consistent instead (see SLOT_FILL_PROMPT).
# Defaults to sequential — Phase 4's own measurement found parallel slower and far more
# expensive in completion tokens on this project's model. See open-problems.md before
# flipping this.
LLM_FILL_MODE=sequential

LLM_EDIT_PROVIDER=
LLM_EDIT_MODEL=
LLM_EDIT_MAX_TOKENS=8000

# The router answers with one short line.
LLM_ROUTER_PROVIDER=
LLM_ROUTER_MODEL=
LLM_ROUTER_MAX_TOKENS=20

# --- Platform credentials ------------------------------------------------------
# Used when a session has supplied no credential of its own.
# OPENAI_BASE_URL must be the API prefix only (e.g. https://host/v1) — the SDK
# appends /chat/completions itself.
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Optional. Leave empty to use the real api.anthropic.com. Set only to point the
# Anthropic adapter at a self-hosted or gateway server that speaks the real Anthropic
# Messages API wire format (not the OpenAI-compatible shape) — e.g. https://host, the
# SDK appends /v1/messages itself. Caching (cache_control) depends on that specific
# server actually implementing it and on the shared prefix being long enough (roughly
# 512-4096 tokens, model-dependent) — see .docs/open-problems.md for how to check.
ANTHROPIC_BASE_URL=

# 32 random bytes, base64. Encrypts stored user credentials. The server refuses to
# start without it. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CREDENTIAL_KEY=

# Signs per-app data-API tokens (Phase 5). Both servers need the same value — studio mints,
# sandbox verifies. Changing it invalidates every existing app's data access at once. Both
# servers refuse to start without it, the same way CREDENTIAL_KEY works above. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_TOKEN_SECRET=

# Caps a single generation's total wall-clock time, independent of the heartbeat that
# keeps the connection alive while a slow plan call is running. Milliseconds.
PREVIEW_TIMEOUT_MS=900000

INTERNAL_SECRET=dev-only-change-me
STUDIO_PORT=3000
SANDBOX_PORT=3001
STUDIO_INTERNAL_URL=http://localhost:3000
# Baked into every generated document's swap runtime (Phase 3) so it can validate
# postMessage edits by exact origin match. Must be the literal origin the browser shows
# for the studio — e.g. http://localhost:3000 and http://127.0.0.1:3000 are different
# strings and the check will silently fail if they don't match.
STUDIO_PUBLIC_URL=http://localhost:3000
# Generated apps are served from <app-id>.apps.localhost:3001 — a per-app origin, so one
# app's localStorage and data-API token are not reachable from another app (locked
# decision #8). {id} is substituted with the app id. Chrome, Edge, and Firefox resolve any
# *.localhost name to loopback with no hosts-file entry. Safari and some corporate DNS do not:
# use hosts entries or a wildcard service such as http://{id}.127.0.0.1.nip.io:3001.
SANDBOX_APP_ORIGIN_TEMPLATE=http://{id}.apps.localhost:3001

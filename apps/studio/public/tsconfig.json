{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@any-app/tsconfig/base.json",
  // Checks the browser scripts under js/. Named tsconfig.json so editors find it from the scripts, and kept
  // apart from the server program because they need the DOM lib and must not see Node globals. Not served:
  // only /css and /js are mounted.
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": [],
    "allowJs": true,
    "checkJs": true,
    // The scripts index NodeList/HTMLCollection in for-loops; a per-element undefined check there is noise.
    "noUncheckedIndexedAccess": false
  },
  "include": ["js/**/*.js", "../types/*.d.ts"]
}

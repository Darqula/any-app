{
  "name": "any-app",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:studio": "npm run dev --workspace @any-app/studio",
    "dev:sandbox": "npm run dev --workspace @any-app/sandbox",
    "migrate": "npm run migrate --workspace @any-app/store",
    "typecheck": "tsc --build --force"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

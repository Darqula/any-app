{
  "name": "any-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "tests"
  ],
  "scripts": {
    "db": "node scripts/db.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:studio": "npm run dev --workspace @any-app/studio",
    "dev:sandbox": "npm run dev --workspace @any-app/sandbox",
    "start:studio": "npm run start --workspace @any-app/studio",
    "start:sandbox": "npm run start --workspace @any-app/sandbox",
    "migrate": "npm run migrate --workspace @any-app/store",
    "migrate:prod": "npm run migrate:prod --workspace @any-app/store",
    "build": "node scripts/build.mjs",
    "build:server": "tsc -b tsconfig.build.json",
    "build:prod": "npm run build:server && node scripts/build.mjs --prod",
    "typecheck": "tsc -p . && tsc -p tests/frontend && tsc -p apps/studio/client",
    "test:backend": "npm run test:backend --workspace @any-app/tests",
    "test:frontend": "npm run test:frontend --workspace @any-app/tests",
    "test": "npm run test:backend && npm run test:frontend"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
